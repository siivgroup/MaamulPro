// ============================================================
// MaamulPro — Tenant Database Schema (Per-Company)
// Contains Core, Construction, and Real Estate modules.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/tenant"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  COMPANY_OWNER
  GENERAL_MANAGER
  ADMIN
  MANAGER
  STAFF
  CONSTRUCTION_MANAGER
  SITE_ENGINEER
  PROJECT_SUPERVISOR
  PROCUREMENT_OFFICER
  STOREKEEPER
  MANPOWER_SUPERVISOR
  REAL_ESTATE_MANAGER
  SALES_AGENT
  RENTAL_OFFICER
  PROPERTY_SUPERVISOR
  MATERIAL_MANAGER
  SALES_STAFF
  INVENTORY_OFFICER
  SUPPLIER_OFFICER
  DELIVERY_OFFICER
}

enum Department {
  GENERAL
  CONSTRUCTION
  REAL_ESTATE
  MATERIAL_MANAGEMENT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  CLEARED
  PROCESSING
  PENDING
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ONGOING
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RENTED
  UNDER_CONTRACT
}

enum DealType {
  SALE
  RENTAL
}

enum DealPaymentStatus {
  PAID
  PARTIAL
  PENDING
  OVERDUE
  REFUNDED
}

enum UnitType {
  KG
  BAG
  PIECE
  METER
  LITER
  TON
  TRUCK_LOAD
  LOT
  SQUARE_METER
  SET
  BUCKET
}

enum InventoryTransactionType {
  RESTOCK
  USAGE
  ADJUSTMENT
  TRANSFER
}

enum RentalPaymentStatus {
  PAID
  UNPAID
  LATE
  PARTIAL
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  RENEWAL_DUE
  TERMINATED
}

enum MaterialProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ReportScheduleFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum WorkforceContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  SUSPENDED
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
}

// ──────────────────────────────────────────────────────────────
// CORE MODULE — System Configuration
// ──────────────────────────────────────────────────────────────

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// ──────────────────────────────────────────────────────────────
// CORE MODULE — Users & Authentication
// ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(STAFF)
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  constructionAccess Boolean @default(true) @map("construction_access")
  realEstateAccess   Boolean @default(true) @map("real_estate_access")
  materialManagementAccess Boolean @default(true) @map("material_management_access")
  language           String   @default("en")

  lastLoginAt DateTime? @map("last_login_at")
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  resetRequestedAt    DateTime? @map("reset_requested_at")
  passwordResetAt     DateTime? @map("password_reset_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  staff        Staff?
  activityLogs ActivityLog[]
  operationalAlertReads OperationalAlertRead[]
  assignedOperationalAlerts OperationalAlert[] @relation("OperationalAlertAssignee")
  approvalLimit Decimal? @db.Decimal(12, 2) @map("approval_limit")
  lockedAccountingPeriods AccountingPeriod[] @relation("AccountingPeriodLocker")
  uploadedDocuments DocumentAttachment[] @relation("DocumentUploader")
  signedDocuments DocumentAttachment[] @relation("DocumentSigner")
  transactions Transaction[]

  projectTasks  ProjectTask[] @relation("TaskAssignee")
  createdDeals  Deal[]        @relation("DealCreator")
  inventoryTransactions InventoryTransaction[]
  constructionInventoryTransactions ConstructionInventoryTransaction[]
  workerLedgerEntries WorkerLedgerEntry[]
  materialSales MaterialSale[]
  rbacUserRoles RbacUserRole[]
  rbacUserPermissions RbacUserPermission[]
  recordedDailyExpenses       DailyOperationalExpense[] @relation("ExpenseRecorder")
  workforceContractPayments   WorkforceContractPayment[]
  workforceContractAdjustments WorkforceContractAdjustment[]
  createdPayrolls             Payroll[] @relation("PayrollCreator")
  approvedPayrolls            Payroll[] @relation("PayrollApprover")
  postedJournalBatches        JournalBatch[] @relation("JournalBatchPoster")


  @@index([email])
  @@map("users")
}

// ──────────────────────────────────────────────────────────────
// CORE MODULE — Permission-Based RBAC
// Roles are permission templates. Users can have multiple roles
// and optional direct grants/denies.
// ──────────────────────────────────────────────────────────────

model RbacPermission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  workspace   String?  @map("workspace")
  label       String
  description String?
  isSystem    Boolean  @default(true) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rolePermissions RbacRolePermission[]
  userPermissions RbacUserPermission[]

  @@index([module])
  @@index([workspace])
  @@map("rbac_permissions")
}

model RbacRole {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  rolePermissions RbacRolePermission[]
  userRoles       RbacUserRole[]

  @@index([isActive])
  @@map("rbac_roles")
}

model RbacRolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at")

  role       RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("rbac_role_permissions")
}

model RbacUserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  createdAt DateTime @default(now()) @map("created_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("rbac_user_roles")
}

model RbacUserPermission {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  permissionId String  @map("permission_id")
  effect       String  @default("ALLOW")
  reason       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@map("rbac_user_permissions")
}

// ──────────────────────────────────────────────────────────────
// CORE MODULE — Staff Management
// ──────────────────────────────────────────────────────────────

model Staff {
  id         String     @id @default(cuid())
  userId     String?    @unique @map("user_id")
  firstName  String     @map("first_name")
  lastName   String     @map("last_name")
  phone      String?
  department Department @default(GENERAL)
  position   String?
  salary     Decimal    @default(0) @db.Decimal(12, 2)
  hireDate   DateTime   @default(now()) @map("hire_date")
  status     StaffStatus @default(ACTIVE)
  notes      String?
  photoUrl   String?   @map("photo_url")

  workerTypeId      String?  @map("worker_type_id")
  assignedProjectId String?  @map("assigned_project_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectTasks ProjectTask[] @relation("TaskStaff")
  workerLedgerEntries WorkerLedgerEntry[]
  dailyExpenses       DailyOperationalExpense[]
  workerType          WorkerType?  @relation(fields: [workerTypeId], references: [id], onDelete: SetNull)
  assignedProject     Project?     @relation(fields: [assignedProjectId], references: [id], onDelete: SetNull)
  workforceContractAssignments WorkforceContractWorker[]
  workforceContractPayments    WorkforceContractPayment[]
  payrollItems                 PayrollItem[]
  manpowerWorker                ManpowerWorker?


  @@index([department])
  @@index([status])
  @@index([workerTypeId])
  @@index([assignedProjectId])
  @@map("staff")
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

// ──────────────────────────────────────────────────────────────
// CORE MODULE — Categories
// ──────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String? @unique
  description String?
  color       String? @default("#6366f1")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  transactions Transaction[]

  @@map("categories")
}

// ──────────────────────────────────────────────────────────────
// CORE MODULE — Financial Transactions (Unified Ledger)
// ──────────────────────────────────────────────────────────────

model Transaction {
  id            String            @id @default(cuid())
  referenceId   String            @unique @default(cuid()) @map("reference_id")
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  description   String
  amount        Decimal           @db.Decimal(12, 2)
  date          DateTime          @default(now())

  categoryId    String?  @map("category_id")
  userId        String?  @map("user_id")
  projectId     String?  @map("project_id")
  propertyId    String?  @map("property_id")
  dealId        String?  @map("deal_id")
  materialId    String?  @map("material_id")

  notes         String?
  version       Int               @default(0)

  journalBatchId String? @map("journal_batch_id")
  postingStatus  String  @default("UNPOSTED") @map("posting_status")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  material     Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  journalBatch JournalBatch? @relation(fields: [journalBatchId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([date])
  @@index([categoryId])
  @@index([projectId])
  @@index([propertyId])
  @@index([materialId])
  @@index([deletedAt, date])
  @@index([deletedAt, type, date])
  @@index([deletedAt, status, date])
  @@index([deletedAt, projectId, date])
  @@index([journalBatchId])
  @@map("transactions")
}

// ──────────────────────────────────────────────────────────────
// CORE MODULE — Activity Logs (Audit Trail)
// ──────────────────────────────────────────────────────────────

model ActivityLog {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  action    String
  entity    String
  entityId  String? @map("entity_id")
  resource  String?
  details   String?
  ipAddress String? @map("ip_address")
  deviceInfo String? @map("device_info")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("activity_logs")
}

model OperationalAlert {
  id                 String    @id @default(cuid())
  sourceKey          String    @map("source_key")
  type               String
  severity           String
  title              String
  details            String?
  targetPath         String?   @map("target_path")
  requiredPermission String    @map("required_permission")
  assigneeId         String?   @map("assignee_id")
  activeAt           DateTime  @default(now()) @map("active_at")
  resolvedAt         DateTime? @map("resolved_at")
  escalatedAt        DateTime? @map("escalated_at")
  lastEmailedAt      DateTime? @map("last_emailed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  reads OperationalAlertRead[]
  assignee User? @relation("OperationalAlertAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([requiredPermission, resolvedAt])
  @@index([activeAt])
  @@index([assigneeId, resolvedAt])
  @@map("operational_alerts")
}

model OperationalAlertRead {
  id        String   @id @default(cuid())
  alertId   String   @map("alert_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")
  dismissedAt DateTime? @map("dismissed_at")

  alert OperationalAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId])
  @@index([userId, readAt])
  @@map("operational_alert_reads")
}

// ──────────────────────────────────────────────────────────────
// CONSTRUCTION MODULE — Projects
// ──────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  location    String?
  description String?
  status      ProjectStatus @default(PLANNING)
  budget      Decimal       @default(0) @db.Decimal(12, 2)
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  progress    Int           @default(0)
  imageUrl    String?       @map("image_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tasks        ProjectTask[]
  transactions Transaction[]
  inventoryTransactions InventoryTransaction[]
  constructionInventoryTransactions ConstructionInventoryTransaction[]
  workerLedgerEntries WorkerLedgerEntry[]
  assignedStaff        Staff[]
  dailyExpenses        DailyOperationalExpense[]
  workforceContracts   WorkforceContract[]
  payrolls             Payroll[]
  manpowerWorkers      ManpowerWorker[]

  @@index([status])
  @@index([deletedAt, status])
  @@map("projects")
}

// ──────────────────────────────────────────────────────────────
// CONSTRUCTION MODULE — Project Tasks
// ──────────────────────────────────────────────────────────────

model ProjectTask {
  id          String       @id @default(cuid())
  projectId   String       @map("project_id")
  title       String
  description String?
  status      TaskStatus   @default(NOT_STARTED)
  priority    TaskPriority @default(MEDIUM)
  progress    Int          @default(0)
  dueDate     DateTime?    @map("due_date")

  assigneeId String? @map("assignee_id")
  staffId    String? @map("staff_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  staff    Staff?  @relation("TaskStaff", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@map("project_tasks")
}

// ──────────────────────────────────────────────────────────────
// CONSTRUCTION MODULE — Inventory
// ──────────────────────────────────────────────────────────────

model Material {
  id          String   @id @default(cuid())
  name        String
  category    String?
  materialType String? @map("material_type")
  photoUrl    String?  @map("photo_url")
  quantity    Decimal  @default(0) @db.Decimal(12, 2)
  unit        UnitType
  unitCost    Decimal  @default(0) @db.Decimal(12, 2) @map("unit_cost")
  salePrice   Decimal  @default(0) @db.Decimal(12, 2) @map("sale_price")
  warehouse   String?
  lowStockThreshold Decimal @default(0) @db.Decimal(12, 2) @map("low_stock_threshold")
  status      MaterialProductStatus @default(ACTIVE)
  version     Int      @default(0)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  transactions InventoryTransaction[]
  purchaseItems PurchaseOrderItem[]
  saleItems MaterialSaleItem[]
  transportationItems TransportationItem[]
  ledgerTransactions Transaction[]

  @@index([name])
  @@index([createdAt])
  @@map("materials")
}

model InventoryTransaction {
  id          String                   @id @default(cuid())
  materialId  String                   @map("material_id")
  projectId   String?                  @map("project_id")
  type        InventoryTransactionType
  quantity    Decimal                  @db.Decimal(12, 2)
  date        DateTime                 @default(now())
  userId      String                   @map("user_id")
  notes       String?
  warehouse   String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([materialId])
  @@index([projectId])
  @@index([date])
  @@index([type, projectId, date])
  @@map("inventory_transactions")
}

model ConstructionMaterial {
  id          String   @id @default(cuid())
  name        String
  category    String?
  materialType String? @map("material_type")
  photoUrl    String?  @map("photo_url")
  quantity    Decimal  @default(0) @db.Decimal(12, 2)
  unit        UnitType
  unitCost    Decimal  @default(0) @db.Decimal(12, 2) @map("unit_cost")
  warehouse   String?
  lowStockThreshold Decimal @default(0) @db.Decimal(12, 2) @map("low_stock_threshold")
  status      MaterialProductStatus @default(ACTIVE)
  version     Int      @default(0)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  transactions ConstructionInventoryTransaction[]

  @@index([name])
  @@index([createdAt])
  @@map("construction_materials")
}

model ConstructionInventoryTransaction {
  id          String                   @id @default(cuid())
  materialId  String                   @map("material_id")
  projectId   String?                  @map("project_id")
  type        InventoryTransactionType
  quantity    Decimal                  @db.Decimal(12, 2)
  date        DateTime                 @default(now())
  userId      String                   @map("user_id")
  supplierId  String?                  @map("supplier_id")
  paymentMethod String?                @map("payment_method")
  unitCost    Decimal?                 @map("unit_cost") @db.Decimal(12, 2)
  totalCost   Decimal?                 @map("total_cost") @db.Decimal(12, 2)
  sourceRef   String?                  @unique @map("source_ref")
  notes       String?
  warehouse   String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  material    ConstructionMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([materialId])
  @@index([projectId])
  @@index([date])
  @@index([supplierId])
  @@index([type, projectId, date])
  @@map("construction_inventory_transactions")
}

model ReportSchedule {
  id          String                  @id @default(cuid())
  reportId    String                  @map("report_id")
  name        String
  frequency   ReportScheduleFrequency
  recipients  String?
  filters     String?
  isActive    Boolean                 @default(true) @map("is_active")
  nextRunAt   DateTime?               @map("next_run_at")
  lastRunAt   DateTime?               @map("last_run_at")
  lastSuccessAt DateTime?             @map("last_success_at")
  lastFailureAt DateTime?             @map("last_failure_at")
  lastError   String?                 @map("last_error")
  lastDeliveryId String?              @map("last_delivery_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([reportId])
  @@index([isActive])
  @@map("report_schedules")
}

model AccountingPeriod {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  status      String   @default("OPEN")
  lockedAt    DateTime? @map("locked_at")
  lockedById  String?  @map("locked_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lockedBy User? @relation("AccountingPeriodLocker", fields: [lockedById], references: [id], onDelete: SetNull)

  @@index([startDate, endDate, status])
  @@map("accounting_periods")
}

model DocumentAttachment {
  id           String   @id @default(cuid())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  filename     String
  url          String
  contentType  String   @map("content_type")
  size         Int
  uploadedById String   @map("uploaded_by_id")
  signedAt     DateTime? @map("signed_at")
  signedById   String?  @map("signed_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy User @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  signedBy User? @relation("DocumentSigner", fields: [signedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("document_attachments")
}

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  email              String?
  phone              String?
  nationalIdPassport String?  @map("national_id_passport")
  propertyId         String?  @map("property_id")
  notes              String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  contracts RentalContract[]
  rentPayments RentPayment[]
  deals     Deal[]

  @@index([propertyId])
  @@map("tenants")
}

model RentalContract {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  propertyId  String         @map("property_id")
  monthlyRent Decimal        @db.Decimal(12, 2) @map("monthly_rent")
  startDate   DateTime       @map("start_date")
  endDate     DateTime       @map("end_date")
  renewalDate DateTime?      @map("renewal_date")
  status      ContractStatus @default(ACTIVE)
  notes       String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments RentPayment[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@map("rental_contracts")
}

model RentPayment {
  id         String              @id @default(cuid())
  tenantId   String              @map("tenant_id")
  contractId String?             @map("contract_id")
  dueDate    DateTime            @map("due_date")
  paidDate   DateTime?           @map("paid_date")
  amountDue  Decimal             @db.Decimal(12, 2) @map("amount_due")
  amountPaid Decimal             @default(0) @db.Decimal(12, 2) @map("amount_paid")
  status     RentalPaymentStatus @default(UNPAID)
  receiptNo  String?             @map("receipt_no")
  notes      String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract RentalContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([dueDate])
  @@index([status])
  @@index([contractId])
  @@index([deletedAt, dueDate])
  @@map("rent_payments")
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  address String?
  balance Decimal @default(0) @db.Decimal(12, 2)
  notes   String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  purchaseOrders PurchaseOrder[]
  transactions SupplierTransaction[]
  constructionInventoryTransactions ConstructionInventoryTransaction[]

  @@map("suppliers")
}

model SupplierTransaction {
  id          String   @id @default(cuid())
  supplierId  String   @map("supplier_id")
  amount      Decimal  @db.Decimal(12, 2)
  description String
  date        DateTime @default(now())

  createdAt DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([date])
  @@map("supplier_transactions")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  supplierId String?             @map("supplier_id")
  orderNo    String              @unique @map("order_no")
  status     PurchaseOrderStatus @default(DRAFT)
  totalCost  Decimal             @default(0) @db.Decimal(12, 2) @map("total_cost")
  orderedAt  DateTime?           @map("ordered_at")
  receivedAt DateTime?           @map("received_at")
  notes      String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String   @map("purchase_order_id")
  materialId      String   @map("material_id")
  quantity        Decimal  @db.Decimal(12, 2)
  unitCost        Decimal  @db.Decimal(12, 2) @map("unit_cost")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([materialId])
  @@map("purchase_order_items")
}

model MaterialCustomer {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  address String?
  balance Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sales MaterialSale[]

  @@map("material_customers")
}

model MaterialSale {
  id          String   @id @default(cuid())
  customerId  String?  @map("customer_id")
  userId      String?  @map("user_id")
  invoiceNo   String   @unique @map("invoice_no")
  totalAmount Decimal  @default(0) @db.Decimal(12, 2) @map("total_amount")
  paidAmount  Decimal  @default(0) @db.Decimal(12, 2) @map("paid_amount")
  discountAmount  Decimal  @default(0) @db.Decimal(12, 2) @map("discount_amount")
  discountPercent Decimal? @db.Decimal(5, 2) @map("discount_percent")
  date        DateTime @default(now())
  notes       String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  customer MaterialCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    MaterialSaleItem[]

  @@index([customerId])
  @@index([date])
  @@index([deletedAt, date])
  @@map("material_sales")
}

model MaterialSaleItem {
  id          String  @id @default(cuid())
  saleId      String  @map("sale_id")
  materialId  String  @map("material_id")
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2) @map("unit_price")

  sale     MaterialSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  material Material     @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([materialId])
  @@map("material_sale_items")
}

model TransportationRecord {
  id                String         @id @default(cuid())
  deliveryNo        String         @unique @map("delivery_no")
  responsiblePerson String         @map("responsible_person")
  cost              Decimal        @default(0) @db.Decimal(12, 2)
  status            DeliveryStatus @default(PENDING)
  deliveryDate      DateTime?      @map("delivery_date")
  notes             String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items TransportationItem[]

  @@index([status])
  @@map("transportation_records")
}

model TransportationItem {
  id             String  @id @default(cuid())
  transportationId String @map("transportation_id")
  materialId     String  @map("material_id")
  quantity       Decimal @db.Decimal(12, 2)

  transportation TransportationRecord @relation(fields: [transportationId], references: [id], onDelete: Cascade)
  material       Material             @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([transportationId])
  @@index([materialId])
  @@map("transportation_items")
}

model WorkerType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?  @default("#6366f1")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  staff Staff[]
  manpowerWorkers ManpowerWorker[]

  @@map("worker_types")
}

model ManpowerWorker {
  id                String      @id @default(cuid())
  linkedStaffId     String?     @unique @map("linked_staff_id")
  firstName         String?     @map("first_name")
  lastName          String?     @map("last_name")
  phone             String?
  position          String?
  workerTypeId      String?     @map("worker_type_id")
  assignedProjectId String?     @map("assigned_project_id")
  notes             String?
  status            StaffStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  linkedStaff     Staff?      @relation(fields: [linkedStaffId], references: [id], onDelete: SetNull)
  workerType      WorkerType? @relation(fields: [workerTypeId], references: [id], onDelete: SetNull)
  assignedProject Project?    @relation(fields: [assignedProjectId], references: [id], onDelete: SetNull)

  contractAssignments WorkforceContractWorker[]
  contractPayments    WorkforceContractPayment[]
  dailyExpenses       DailyOperationalExpense[]
  ledgerEntries       WorkerLedgerEntry[]

  @@index([workerTypeId])
  @@index([assignedProjectId])
  @@index([status])
  @@index([deletedAt])
  @@map("manpower_workers")
}

model DailyOperationalExpense {
  id              String   @id @default(cuid())
  staffId         String?  @map("staff_id")
  workerId        String?  @map("worker_id")
  projectId       String?  @map("project_id")
  recordedByUserId String? @map("recorded_by_user_id")
  amount          Decimal  @db.Decimal(12, 2)
  description     String
  category        String   @default("OTHER")
  date            DateTime @default(now())

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  staff        Staff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  worker       ManpowerWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recordedBy   User?           @relation("ExpenseRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([workerId])
  @@index([projectId])
  @@index([recordedByUserId])
  @@index([date])
  @@index([category])
  @@index([deletedAt, projectId, date])
  @@map("daily_operational_expenses")
}

model WorkerLedgerEntry {
  id          String          @id @default(cuid())
  userId      String?         @map("user_id")
  staffId     String?         @map("staff_id")
  workerId    String?         @map("worker_id")
  projectId   String?         @map("project_id")
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String
  date        DateTime        @default(now())

  createdAt DateTime @default(now()) @map("created_at")

  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  staff   Staff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  worker  ManpowerWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  project Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([workerId])
  @@index([projectId])
  @@index([date])
  @@map("worker_ledger_entries")
}

// ──────────────────────────────────────────────────────────────
// REAL ESTATE MODULE — Properties
// ──────────────────────────────────────────────────────────────

model Property {
  id          String         @id @default(cuid())
  title       String
  type        PropertyType
  status      PropertyStatus @default(AVAILABLE)
  address     String?
  description String?
  price       Decimal        @default(0) @db.Decimal(12, 2)
  area        Decimal?       @db.Decimal(10, 2)
  bedrooms    Int?
  bathrooms   Int?
  imageUrl    String?        @map("image_url")
  version     Int            @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  deals        Deal[]
  transactions Transaction[]
  tenants      Tenant[]
  rentalContracts RentalContract[]

  @@index([type])
  @@index([status])
  @@map("properties")
}

// ──────────────────────────────────────────────────────────────
// REAL ESTATE MODULE — Deals
//
// Deal counterparties ("clients") are Tenant rows — the real estate
// contact directory is unified under Tenant (superset of the old,
// now-retired Client model). See tenant-schema-sql.ts v17 for the
// backfill/FK migration.
// ──────────────────────────────────────────────────────────────

model Deal {
  id            String            @id @default(cuid())
  propertyId    String            @map("property_id")
  clientId      String            @map("client_id")
  createdById   String?           @map("created_by_id")
  type          DealType
  paymentStatus DealPaymentStatus @default(PENDING) @map("payment_status")
  totalAmount   Decimal           @default(0) @db.Decimal(12, 2) @map("total_amount")
  paidAmount    Decimal           @default(0) @db.Decimal(12, 2) @map("paid_amount")
  notes         String?
  version       Int               @default(0)

  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  client      Tenant        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("DealCreator", fields: [createdById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([propertyId])
  @@index([clientId])
  @@index([paymentStatus])
  @@index([deletedAt, paymentStatus])
  @@map("deals")
}

enum AccountType {
  INCOME
  EXPENSE
  ASSET
  LIABILITY
  EQUITY
}

model Account {
  code          String      @id
  name          String
  parentCode    String?     @map("parent_code")
  type          AccountType
  tenantId      String      @map("tenant_id")
  description   String?
  isActive      Boolean     @default(true) @map("is_active")
  allowNegative Boolean     @default(true) @map("allow_negative")
  normalBalance String      @default("DEBIT") @map("normal_balance")
  isSystem      Boolean     @default(false) @map("is_system")

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  parent   Account?  @relation("AccountParent", fields: [parentCode], references: [code], onDelete: Restrict)
  children Account[] @relation("AccountParent")

  journalEntries JournalEntry[]
  payrolls       Payroll[]
  mappings       AccountMapping[]

  @@index([isActive])
  @@map("accounts")
}

model JournalBatch {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  batchNumber         String    @unique @map("batch_number")
  date                DateTime
  memo                String?
  sourceType          String    @default("MANUAL") @map("source_type")
  sourceId            String?   @map("source_id")
  sourceRef           String?   @map("source_ref")
  status              String    @default("POSTED")
  totalDebit          Decimal   @default(0) @db.Decimal(14, 2) @map("total_debit")
  totalCredit         Decimal   @default(0) @db.Decimal(14, 2) @map("total_credit")
  postedById          String?   @map("posted_by_id")
  postedAt            DateTime? @map("posted_at")
  reversesBatchId     String?   @map("reverses_batch_id")
  reversedByBatchId   String?   @map("reversed_by_batch_id")
  version             Int       @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  postedBy        User?          @relation("JournalBatchPoster", fields: [postedById], references: [id], onDelete: SetNull)
  reverses        JournalBatch?  @relation("JournalBatchReversal", fields: [reversesBatchId], references: [id], onDelete: SetNull)
  reversedBy      JournalBatch[] @relation("JournalBatchReversal")
  entries         JournalEntry[]
  transactions    Transaction[]

  @@index([date])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([deletedAt, date])
  @@map("journal_batches")
}

model JournalEntry {
  id               String   @id @default(cuid())
  batchId          String?  @map("batch_id")
  tenantId         String   @map("tenant_id")
  accountCode      String   @map("account_code")
  type             String
  date             DateTime
  contactName      String?  @map("contact_name")
  memo             String?
  splitAccountCode String?  @map("split_account_code")
  debit            Decimal  @db.Decimal(12, 2)
  credit           Decimal  @db.Decimal(12, 2)
  lineNumber       Int      @default(0) @map("line_number")
  clearedStatus    Boolean  @default(false) @map("cleared_status")
  createdAt        DateTime @default(now()) @map("created_at")

  account          Account       @relation(fields: [accountCode], references: [code], onDelete: Cascade)
  batch            JournalBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("journal_entries")
}

model AccountMapping {
  key         String   @id
  accountCode String   @map("account_code")
  description String?
  updatedById String?  @map("updated_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account   Account @relation(fields: [accountCode], references: [code], onDelete: Restrict)

  @@index([accountCode])
  @@map("account_mappings")
}

// ──────────────────────────────────────────────────────────────
// CONSTRUCTION MODULE — Workforce Contract Budget Management
// ──────────────────────────────────────────────────────────────

model WorkforceContract {
  id             String                   @id @default(cuid())
  projectId      String                   @map("project_id")
  title          String
  description    String?
  contractorName String?                  @map("contractor_name")
  originalBudget Decimal                  @db.Decimal(12, 2) @map("original_budget")
  totalPaid      Decimal                  @default(0) @db.Decimal(12, 2) @map("total_paid")
  status         WorkforceContractStatus  @default(DRAFT)
  startDate      DateTime?                @map("start_date")
  endDate        DateTime?                @map("end_date")
  notes          String?
  version        Int                      @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  project             Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerAssignments   WorkforceContractWorker[]
  payments            WorkforceContractPayment[]
  budgetAdjustments   WorkforceContractAdjustment[]

  @@index([projectId])
  @@index([status])
  @@map("workforce_contracts")
}

model WorkforceContractWorker {
  id          String   @id @default(cuid())
  contractId  String   @map("contract_id")
  staffId     String?  @map("staff_id")
  workerId    String?  @map("worker_id")
  role        String?
  notes       String?

  assignedAt DateTime  @default(now()) @map("assigned_at")
  removedAt  DateTime? @map("removed_at")

  contract WorkforceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  staff    Staff?            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  worker   ManpowerWorker?   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([contractId, staffId])
  @@unique([contractId, workerId])
  @@index([staffId])
  @@index([workerId])
  @@map("workforce_contract_workers")
}

model WorkforceContractPayment {
  id           String   @id @default(cuid())
  contractId   String   @map("contract_id")
  staffId      String?  @map("staff_id")
  workerId     String?  @map("worker_id")
  payeeName    String?  @map("payee_name")
  amount       Decimal  @db.Decimal(12, 2)
  date         DateTime @default(now())
  description  String
  recordedById String   @map("recorded_by_id")
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")

  contract   WorkforceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  staff      Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  worker     ManpowerWorker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  recordedBy User              @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([staffId])
  @@index([workerId])
  @@index([date])
  @@map("workforce_contract_payments")
}

model WorkforceContractAdjustment {
  id           String   @id @default(cuid())
  contractId   String   @map("contract_id")
  amount       Decimal  @db.Decimal(12, 2)
  reason       String
  adjustedById String   @map("adjusted_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  contract   WorkforceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  adjustedBy User              @relation(fields: [adjustedById], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@map("workforce_contract_adjustments")
}

// ──────────────────────────────────────────────────────────────
// CORE MODULE — Payroll & Payslips Workflow
// ──────────────────────────────────────────────────────────────

model Payroll {
  id                String        @id @default(cuid())
  name              String
  year              Int
  month             Int
  payPeriod         String?       @map("pay_period")
  paymentDate       DateTime?     @map("payment_date")
  status            PayrollStatus @default(DRAFT)
  rejectionReason   String?       @map("rejection_reason")

  totalBaseSalary   Decimal       @default(0) @db.Decimal(12, 2) @map("total_base_salary")
  totalBonuses      Decimal       @default(0) @db.Decimal(12, 2) @map("total_bonuses")
  totalDeductions   Decimal       @default(0) @db.Decimal(12, 2) @map("total_deductions")
  totalTax          Decimal       @default(0) @db.Decimal(12, 2) @map("total_tax")
  totalGrossSalary  Decimal       @default(0) @db.Decimal(12, 2) @map("total_gross_salary")
  totalNetSalary    Decimal       @default(0) @db.Decimal(12, 2) @map("total_net_salary")

  expenseAccountCode String?      @map("expense_account_code")
  projectId          String?      @map("project_id")
  createdById        String?      @map("created_by_id")
  approvedById       String?      @map("approved_by_id")

  approvedAt        DateTime?     @map("approved_at")
  paidAt            DateTime?     @map("paid_at")

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  createdByUser     User?         @relation("PayrollCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedByUser    User?         @relation("PayrollApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  expenseAccount    Account?      @relation(fields: [expenseAccountCode], references: [code], onDelete: SetNull)
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items             PayrollItem[]

  @@unique([year, month, deletedAt])
  @@index([status])
  @@index([year, month])
  @@index([projectId])
  @@index([deletedAt, createdAt])
  @@map("payrolls")
}

model PayrollItem {
  id                 String        @id @default(cuid())
  payrollId          String        @map("payroll_id")
  staffId            String?       @map("staff_id")
  
  // Historical snapshot fields
  employeeName       String        @map("employee_name")
  employeePosition   String?       @map("employee_position")
  employeeDepartment Department    @default(GENERAL) @map("employee_department")

  baseSalary         Decimal       @default(0) @db.Decimal(12, 2) @map("base_salary")
  bonuses            Decimal       @default(0) @db.Decimal(12, 2)
  deductions         Decimal       @default(0) @db.Decimal(12, 2)
  tax                Decimal       @default(0) @db.Decimal(12, 2)
  grossSalary        Decimal       @default(0) @db.Decimal(12, 2) @map("gross_salary")
  netSalary          Decimal       @default(0) @db.Decimal(12, 2) @map("net_salary")

  payslipNumber      String?       @map("payslip_number")
  status             PayrollStatus @default(DRAFT)
  notes              String?

  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  payroll            Payroll       @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  staff              Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([payrollId])
  @@index([staffId])
  @@index([payslipNumber])
  @@map("payroll_items")
}

