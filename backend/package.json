{
  "name": "maamulpro-backend",
  "version": "1.0.0",
  "description": "Enterprise NestJS Multi-Tenant SaaS Backend for MaamulPro",
  "author": "MaamulPro Architect",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npx nest build",
    "prisma:generate": "npm run prisma:generate:central && npm run prisma:generate:tenant",
    "prisma:generate:central": "npx prisma generate --config prisma.config.ts",
    "prisma:generate:tenant": "npx prisma generate --schema prisma/tenant/schema.prisma",
    "seed": "ts-node scripts/seed-superadmin.ts",
    "neon:check": "ts-node scripts/check-neon.ts",
    "neon:central:push": "npx prisma db push --config prisma.config.ts",
    "neon:encrypt-tenants": "ts-node scripts/encrypt-tenant-database-urls.ts",
    "neon:setup": "node scripts/setup-neon.mjs",
    "onboarding:recover": "ts-node scripts/recover-onboarding.ts",
    "migrations:central:integrity": "node scripts/apply-central-migrations.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test:contracts": "node --test test/*.test.mjs",
    "test:e2e:db": "node scripts/run-database-e2e.mjs",
    "test:e2e:db:external": "node scripts/run-database-e2e.mjs",
    "test:e2e:api": "node -r dotenv/config scripts/probe-live-api.mjs",
    "test:load": "node scripts/probe-load.mjs",
    "schemas:sync:live": "node -r dotenv/config scripts/sync-live-tenant-schemas.mjs dotenv_config_path=.env",
    "test:e2e:enhancements": "node -r dotenv/config scripts/probe-enhancements.mjs dotenv_config_path=.env",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@vercel/blob": "^2.3.3",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.1.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
