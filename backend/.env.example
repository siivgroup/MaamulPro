PORT=4000
DATABASE_PROVIDER=neon
CENTRAL_DATABASE_URL=postgresql://owner:password@ep-example.region.aws.neon.tech/maamulpro_central?sslmode=require
TENANT_DATABASE_ENCRYPTION_KEY=replace-with-64-hex-characters

# Needed only for automatic tenant database creation.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_DB_ROLE=neondb_owner

JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173
TENANT_BASE_DOMAIN=maamulpro.site
RESEND_API_KEY=
RESEND_FROM=MaamulPro <noreply@example.com>
# Optional: defaults to https://admin.<TENANT_BASE_DOMAIN>; HTTPS platform origin only.
EMAIL_PUBLIC_ORIGIN=
# Optional monitored reply-to/support mailbox. Leave empty if not available.
EMAIL_SUPPORT_ADDRESS=
# In Resend, keep open and click tracking disabled for the sending domain.
BLOB_READ_WRITE_TOKEN=
APP_VERSION=development
SLOW_REQUEST_MS=1500
